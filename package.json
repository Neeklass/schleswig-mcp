{
  "name": "schleswig-mcp",
  "version": "0.1.0",
  "description": "Local HTTP API and MCP server for public information about Schleswig, Germany.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/src/index.js",
    "docs:generate": "node scripts/generate-docs.mjs",
    "predev": "npm run docs:generate",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run docs:generate",
    "test": "vitest run",
    "pretest:watch": "npm run docs:generate",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:build": "node scripts/check-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "csv-parse": "7.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
